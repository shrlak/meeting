# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite works out of the box for local development.
DATABASE_URL="file:./dev.db"

# "sqlite" (default) or "postgresql". Hosted deployments need "postgresql",
# because serverless filesystems are wiped between requests. Setting this makes
# the build point prisma/schema.prisma at the right engine — you do not have to
# edit the schema by hand.
# DATABASE_PROVIDER="postgresql"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public base URL of the app. Used to build booking links and the Google OAuth
# redirect URI. No trailing slash. On Vercel this falls back to the project's
# production domain, but set it explicitly once you have a custom domain.
APP_URL="http://localhost:3000"

# Secret used to sign login session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# ---------------------------------------------------------------------------
# Google Calendar (optional)
# ---------------------------------------------------------------------------
# Create an OAuth 2.0 Client ID (type: Web application) in Google Cloud Console,
# enable the Google Calendar API, and add this redirect URI:
#   {APP_URL}/api/google/callback
# Leave these blank to run without calendar sync — bookings still work and the
# confirmation page offers a downloadable .ics invite instead.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
